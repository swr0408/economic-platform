# ============================================================================
# .env.production.example - Lightsail 本番用テンプレート
# ============================================================================
# このファイルを .env にコピーして値を埋める:
#   cp .env.production.example .env
#
# 注意: .env は .gitignore 済。秘密情報をリポジトリにコミットしないこと。
# ============================================================================

# ---------- Infrastructure ----------

# PostgreSQL (Lightsail VM 上の Docker コンテナ)
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/economic_platform

# Redis
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ---------- Domain / HTTPS ----------

# Caddy が自動 HTTPS を取得するドメイン (DNS の A レコードを VM IP に向けること)
# API 用ドメイン
API_DOMAIN=api.example.com

# フロントエンド URL (CORS の ALLOWED_ORIGINS_EXTRA に含める)
# FRONTEND_DOMAIN=app.example.com

# ---------- CORS / Cookie ----------

# 本番フロントエンドの origin (カンマ区切りで複数指定可)
ALLOWED_ORIGINS_EXTRA=https://app.example.com
COOKIE_SECURE=true

# ---------- Frontend ----------

# フロントエンドからバックエンド API への接続先
# Nginx 同一 VM 構成ならプロキシ経由なので空文字でよい
# 別ドメインの場合は https://api.example.com を指定
VITE_API_BASE_URL=

# ---------- API Keys (必須) ----------

FRED_API_KEY=
FMP_API_KEY=
ESTAT_API_KEY=

# ---------- API Keys (機能別) ----------

BEA_API_KEY=
BLS_API_KEY=
ALPHA_VANTAGE_API_KEY=
TRADING_ECONOMICS_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
DESTATIS_USERNAME=
DESTATIS_PASSWORD=

# ---------- AI Services ----------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Social / Notifications ----------

TWITTER_BEARER_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_FJ_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- Playwright (Lightsail) ----------

# Chromium 同時起動数 (2GB プランなら 1、4GB なら 2)
BROWSER_RUNNER_CONCURRENCY=1
PLAYWRIGHT_NO_SANDBOX=1

# ---------- uvicorn ----------

# 本番では false (reload しない)
UVICORN_RELOAD=false
