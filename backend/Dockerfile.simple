FROM python:3.11-slim

WORKDIR /app/backend

# 必要なシステムライブラリをインストール（Playwright用を含む）
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    # Playwright/Chromium依存
    wget \
    gnupg \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libatspi2.0-0 \
    libgtk-3-0 \
    fonts-liberation \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# Python依存関係をインストール
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    pandas \
    requests \
    redis \
    psycopg2-binary \
    asyncpg \
    sqlalchemy \
    xlrd \
    openpyxl \
    beautifulsoup4 \
    lxml \
    playwright \
    PyMuPDF \
    pdfplumber \
    Pillow \
    APScheduler \
    pytz \
    yfinance

# Playwrightブラウザをインストール（ChromiumとFirefox）
RUN playwright install chromium firefox

# アプリケーションコード
COPY backend/ /app/backend/

# データディレクトリ（スクリーンショット用含む）
RUN mkdir -p /app/data /app/screenshots

# ポート公開
EXPOSE 8000

# 環境変数
ENV PYTHONPATH=/app/backend
ENV SEASONALITY_DIR=/app/data/seasonality
ENV SCREENSHOT_DIR=/app/screenshots

# デフォルトコマンド
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
