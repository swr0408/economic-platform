# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/economic_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys
FRED_API_KEY=your_fred_api_key_here
FMP_API_KEY=your_fmp_api_key_here
BEA_API_KEY=your_bea_api_key_here
BLS_API_KEY=your_bls_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ESTAT_API_KEY=your_estat_api_key_here
TRADING_ECONOMICS_API_KEY=your_trading_economics_key_here
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_key_here
DESTATIS_USERNAME=your_destatis_username_here
DESTATIS_PASSWORD=your_destatis_password_here

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Social Media / News
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_FJ_CHANNEL_ID=your_discord_channel_id_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token_here

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# CORS (本番用。カンマ区切りで追加 origin を指定)
# ALLOWED_ORIGINS_EXTRA=https://app.example.com

# DB Password (本番用。デフォルトは postgres)
# POSTGRES_PASSWORD=change_me_in_production

# Redis Password (本番用)
# REDIS_PASSWORD=change_me_in_production

# Cookie (本番では true にする)
# COOKIE_SECURE=true

# uvicorn reload (ローカル開発のみ true)
# UVICORN_RELOAD=true
